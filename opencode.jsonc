{
  "$schema": "https://opencode.ai/config.json",
  // Theme configuration
  "theme": "opencode",
  "model": "deepseek/deepseek-v4-pro",
  "autoupdate": true,

  "mcp": {
        "n8n-mcp": {
            "enabled": true,
            "command": ["pnpx", "n8n-mcp"],
            "type": "local",
            "environment": {
                "MCP_MODE": "stdio",
                "LOG_LEVEL": "error",
                "DISABLE_CONSOLE_OUTPUT": "true",
                "N8N_API_URL": "http://localhost:5678",
                "N8N_API_KEY": ""
            }
        }
    }
}